# Copy to brain/.env and fill in. brain/.env is gitignored. Never commit keys.
GEMINI_API_KEY=
# Model names (verify with: python3 brain/scripts/check_key.py)
MODEL_AGENT=gemini-3.5-flash-lite
MODEL_LITE=gemini-3.1-flash-lite
MODEL_FALLBACK=gemini-3.1-flash-lite
MODEL_PREMIUM=gemini-3.8-flash
MODEL_EMBED=gemini-embedding-001
# Embeddings: local sentence-transformers by default (no quota); set gemini to use the API
EMBED_BACKEND=local
# Client-side limits sit just under the free tier (see app/config.py); override here
