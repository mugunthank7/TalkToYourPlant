# Copy to brain/.env and fill in. brain/.env is gitignored. Never commit keys.
GEMINI_API_KEY=
# Model names (verify with: python3 brain/scripts/check_key.py)
MODEL_AGENT=gemini-2.5-flash
MODEL_LITE=gemini-2.5-flash-lite
MODEL_FALLBACK=gemini-2.5-flash-lite
MODEL_EMBED=gemini-embedding-001
# Client-side limits (set BELOW your real quota; free tier is low and changes)
RPM_AGENT=8
RPM_LITE=12
RPM_EMBED=50
RPD_AGENT=200
RPD_LITE=800
RPD_EMBED=5000
